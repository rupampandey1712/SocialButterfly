# Optional. Defaults to FastAPIBackend/socialmedia.db
DATABASE_URL=sqlite:///./socialmedia.db
# Optional. Defaults to FastAPIBackend/media
MEDIA_ROOT=
AZURE_STORAGE_CONNECTION_STRING=
BLOB_PUBLIC_BASE_URL=
AZURE_SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_WORKER_MODE=python
# Optional: prefix every queue name (e.g. py-) so this backend and the .NET Functions
# don't consume each other's messages when they share one Service Bus namespace.
SERVICEBUS_QUEUE_PREFIX=
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters
JWT_VALID_ISSUER=http://localhost:8080
JWT_VALID_AUDIENCE=http://localhost:8080
JWT_TOKEN_VALIDITY_IN_MINUTES=60
COOKIE_SECURE=0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_ENV=Development

# Email (required for production email verification codes)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# SMS through Twilio (required for production phone verification codes)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ComfyUI image generation (defaults to http://127.0.0.1:8188)
COMFYUI_URL=http://127.0.0.1:8188
# Optional: defaults to ComfyUI/flux-schnell-txt2img.json in this folder
COMFY_WORKFLOW_PATH=

# Optional NVIDIA NIM text generation
NIM_BASE_URL=
NVIDIA_API_KEY=
NIM_MODEL=
POW_SECRET=
